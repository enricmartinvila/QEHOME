---
import BaseLayout from "../../layouts/BaseLayout.astro"
import HomePage from "../../components/HomePage.astro"
import { getTranslations } from "../../constants/i18n"
import { homeJsonLd } from "../../constants/pageSchema"

const lang = "ca"
const t = getTranslations(lang)
const seo = t.seo.home
const heroImage = "/images/menjador12.webp"
---

<BaseLayout
	lang={lang}
	title={seo.title}
	description={seo.metaDescription}
	ogImage={heroImage}
	preloadImage={heroImage}
	jsonLd={homeJsonLd(lang, seo.jsonLdDescription, heroImage)}
>
	<HomePage lang={lang} />
</BaseLayout>
