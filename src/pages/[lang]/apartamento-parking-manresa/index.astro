---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import ParkingLandingPage from "../../../components/landing/ParkingLandingPage.astro"
import { getTranslations } from "../../../constants/i18n"
import { parkingLandingJsonLd } from "../../../constants/pageSchema"
import { LANGS, type Lang } from "../../../constants/site"
import { PARKING_LANDING } from "../../../constants/landings"

export function getStaticPaths() {
	return LANGS.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = getTranslations(lang)
const seo = t.seo.parking
const page = t.parkingPage
const pathAfterLang = PARKING_LANDING.slug
const heroImage = PARKING_LANDING.heroImage
---

<BaseLayout
	lang={lang}
	title={seo.title}
	description={seo.metaDescription}
	pathAfterLang={pathAfterLang}
	ogImage={heroImage}
	preloadImage={heroImage}
	jsonLd={parkingLandingJsonLd({
		lang,
		slug: pathAfterLang,
		description: seo.metaDescription,
		image: heroImage,
		homeLabel: page.breadcrumbHome,
		currentLabel: page.breadcrumbCurrent,
	})}
>
	<ParkingLandingPage lang={lang} />
</BaseLayout>
