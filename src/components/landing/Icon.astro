---
import { ICON_PATHS, type IconName } from "./icons"

interface Props {
	name: IconName
	class?: string
}

const { name, class: className = "h-5 w-5" } = Astro.props
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d={ICON_PATHS[name]} />
</svg>
