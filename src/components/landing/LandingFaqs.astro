---
import Icon from "./Icon.astro"

interface Props {
	title?: string
	faqs: Array<{ q: string; a: string }>
}

const { title, faqs } = Astro.props
---

{
	faqs.length > 0 && (
		<section id="faq" class="reveal mt-10 scroll-mt-28 md:mt-14">
			<div class="flex items-center gap-4">
				<span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-stone-900 text-brand-cta">
					<Icon name="question" class="h-6 w-6" />
				</span>
				<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">{title || "FAQ"}</h2>
			</div>
			<div class="mt-6 space-y-3">
				{faqs.map((faq, i) => (
					<details
						class="group rounded-2xl border border-stone-200 bg-white shadow-sm transition open:border-brand/30 open:shadow-md"
						open={i === 0}
					>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-stone-900 md:px-6 md:py-5 [&::-webkit-details-marker]:hidden">
							<span>{faq.q}</span>
							<span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-600 transition group-open:rotate-45 group-open:bg-brand group-open:text-white">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
									<path d="M12 5v14M5 12h14" />
								</svg>
							</span>
						</summary>
						<p class="landing-prose px-5 pb-5 md:px-6 md:pb-6">{faq.a}</p>
					</details>
				))}
			</div>
		</section>
	)
}
