---
/**
 * Decorative dusk landscapes used instead of photos on the guide pages
 * (we only have interior photos of the apartment).
 */
import type { IllustrationVariant } from "../../constants/landingDecor"

interface Props {
	variant: IllustrationVariant
	class?: string
	idSuffix?: string
}

const { variant, class: className = "", idSuffix = variant } = Astro.props
const W = 1440
const H = 640

function rng(seed: number) {
	let s = seed
	return () => {
		s = (s * 16807) % 2147483647
		return (s - 1) / 2147483646
	}
}

/**
 * Cluster of rounded rock "fingers" (the agulles of Montserrat). Many
 * overlapping domes under a multi-peak envelope give an organic massif.
 */
function pinnacleRidge(opts: {
	x0: number
	x1: number
	base: number
	peak: number
	seed: number
	count: number
	minW: number
	maxW: number
}) {
	const r = rng(opts.seed)
	const bump = (t: number, c: number, w: number) => Math.exp(-(((t - c) / w) ** 2))
	const env = (t: number) =>
		Math.min(1, 0.55 * bump(t, 0.28, 0.2) + 1 * bump(t, 0.56, 0.17) + 0.7 * bump(t, 0.78, 0.13) + 0.25 * bump(t, 0.95, 0.08))
	let d = ""
	for (let i = 0; i < opts.count; i++) {
		const t = r()
		const x = opts.x0 + t * (opts.x1 - opts.x0)
		const w = opts.minW + r() * (opts.maxW - opts.minW)
		const h = opts.peak * env(t) * (0.55 + r() * 0.45) + 20
		const top = opts.base - h
		const rx = w / 2
		const ry = Math.min(rx * (0.9 + r() * 0.5), h)
		d += `M${(x - rx).toFixed(1)} ${opts.base + 10} L${(x - rx).toFixed(1)} ${(top + ry).toFixed(1)} A${rx.toFixed(1)} ${ry.toFixed(1)} 0 0 1 ${(x + rx).toFixed(1)} ${(top + ry).toFixed(1)} L${(x + rx).toFixed(1)} ${opts.base + 10} Z `
	}
	return d
}

/** Smooth rolling hills through the given y values, evenly spaced. */
function hills(ys: number[]) {
	const step = W / (ys.length - 1)
	let d = `M0 ${H} L0 ${ys[0]}`
	for (let i = 1; i < ys.length; i++) {
		const x0 = (i - 1) * step
		const x1 = i * step
		d += ` C${x0 + step / 2} ${ys[i - 1]} ${x1 - step / 2} ${ys[i]} ${x1} ${ys[i]}`
	}
	return `${d} L${W} ${H} Z`
}

/** Curved vineyard rows that follow a hillside. */
function vineRows(count: number, yStart: number, gap: number) {
	return Array.from({ length: count }, (_, i) => {
		const y = yStart + i * gap
		const bow = 30 + i * 6
		return `M-40 ${y + bow} Q${W / 2} ${y - bow} ${W + 40} ${y + bow * 0.4}`
	})
}

const ids = {
	sky: `sky-${idSuffix}`,
	glow: `glow-${idSuffix}`,
	clipVines: `vines-${idSuffix}`,
}

const massifBack = pinnacleRidge({ x0: 300, x1: 1300, base: 480, peak: 270, seed: 7, count: 120, minW: 22, maxW: 64 })
const massif = pinnacleRidge({ x0: 340, x1: 1260, base: 500, peak: 200, seed: 23, count: 110, minW: 26, maxW: 70 })
const massifSmall = pinnacleRidge({ x0: 760, x1: 1300, base: 450, peak: 110, seed: 11, count: 70, minW: 12, maxW: 34 })
const vineHill = hills([520, 470, 440, 455, 500, 480, 450])
const rows = vineRows(9, 470, 22)

const sunPos =
	variant === "montserrat"
		? { x: 330, y: 300 }
		: variant === "vineyard"
			? { x: 1080, y: 330 }
			: variant === "cardona"
				? { x: 760, y: 250 }
				: { x: 1300, y: 210 }

/** Jagged pale salt outcrop with gullies (Muntanya de Sal, Cardona) */
function saltMountain(x0: number, x1: number, base: number, peak: number, seed: number) {
	const r = rng(seed)
	const bump = (t: number, c: number, w: number) => Math.exp(-(((t - c) / w) ** 2))
	const n = 48
	const pts: Array<[number, number]> = []
	for (let i = 0; i <= n; i++) {
		const t = i / n
		const env = Math.min(1, 0.55 * bump(t, 0.3, 0.2) + bump(t, 0.6, 0.18) + 0.35 * bump(t, 0.85, 0.1))
		pts.push([x0 + t * (x1 - x0), base - peak * env - 6 - r() * 16])
	}
	const outline = `M${x0} ${base + 10} ` + pts.map(([x, y]) => `L${x.toFixed(1)} ${y.toFixed(1)}`).join(" ") + ` L${x1} ${base + 10} Z`
	const gullies = pts
		.filter(([, y], i) => i % 2 === 0 && base - y > 50)
		.map(([x, y]) => {
			const len = (base - y) * (0.35 + r() * 0.4)
			return `M${x.toFixed(1)} ${(y + 6).toFixed(1)} l${(r() * 8 - 4).toFixed(1)} ${len.toFixed(1)}`
		})
	return { outline, gullies }
}
const saltBack = saltMountain(300, 960, 560, 200, 9)
const salt = saltMountain(120, 860, 570, 170, 5)
const crenels = (x: number, y: number, w: number, step = 14) =>
	Array.from({ length: Math.floor(w / step) }, (_, i) => `M${x + i * step} ${y} h${step / 2} v-10 h-${step / 2} Z`).join(" ")

// Pont Vell: deck with pointed arch openings over the river
const bridge =
	"M440 512 L970 512 L970 566 L440 566 Z " +
	[470, 548, 630, 718, 806, 884]
		.map((x, i) => {
			const span = i === 2 || i === 3 ? 70 : 56
			const top = i === 2 || i === 3 ? 528 : 540
			return `M${x} 566 L${x} ${top + 14} Q${x} ${top} ${x + span / 2} ${top - 6} Q${x + span} ${top} ${x + span} ${top + 14} L${x + span} 566 Z`
		})
		.join(" ")
---

<svg
	class={className}
	viewBox={`0 0 ${W} ${H}`}
	preserveAspectRatio="xMidYMax slice"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={ids.sky} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#1c1712" />
			<stop offset="0.45" stop-color="#4a3519" />
			<stop offset="0.8" stop-color="#a77a2c" />
			<stop offset="1" stop-color="#d9ad52" />
		</linearGradient>
		<radialGradient id={ids.glow}>
			<stop offset="0" stop-color="#f7dc8f" stop-opacity="0.95" />
			<stop offset="0.25" stop-color="#f0c766" stop-opacity="0.55" />
			<stop offset="1" stop-color="#f0c766" stop-opacity="0" />
		</radialGradient>
	</defs>

	<rect width={W} height={H} fill={`url(#${ids.sky})`} />
	<circle cx={sunPos.x} cy={sunPos.y} r="260" fill={`url(#${ids.glow})`} />
	<circle cx={sunPos.x} cy={sunPos.y} r="46" fill="#f9e3a3" opacity="0.9" />

	{
		variant === "montserrat" && (
			<g>
				<path d={massifBack} fill="#a98543" opacity="0.75" />
				<path d={massif} fill="#7c5d2e" />
				<path d={hills([560, 520, 540, 500, 530, 510, 545])} fill="#5a4222" />
				<path d={hills([600, 585, 560, 590, 570, 595, 575])} fill="#2c2114" />
			</g>
		)
	}

	{
		variant === "vineyard" && (
			<g>
				<path d={massifSmall} fill="#9a7840" opacity="0.7" />
				<path d={hills([470, 455, 480, 445, 470, 450, 465])} fill="#7a5c2e" opacity="0.85" />
				<clipPath id={ids.clipVines}>
					<path d={vineHill} />
				</clipPath>
				<path d={vineHill} fill="#4b3a1d" />
				<g clip-path={`url(#${ids.clipVines})`} stroke="#6f5a2a" stroke-width="5" stroke-dasharray="2 9" stroke-linecap="round" fill="none">
					{rows.map((d) => <path d={d} />)}
				</g>
				{/* dry-stone "tina" */}
				<g transform="translate(300 448)">
					<path d="M-34 22 L-34 4 Q0 -34 34 4 L34 22 Z" fill="#2e2415" />
					<path d="M-8 22 L-8 6 Q0 -4 8 6 L8 22 Z" fill="#c99a44" opacity="0.55" />
				</g>
				<path d={hills([610, 595, 580, 600, 585, 600, 590])} fill="#241b10" />
			</g>
		)
	}

	{
		variant === "city" && (
			<g>
				<path d={hills([420, 400, 430, 390, 415, 395, 410])} fill="#9a7840" opacity="0.6" />
				<path d={hills([490, 470, 455, 470, 480, 460, 490])} fill="#6c5129" />
				<g transform="translate(470 0)">
				{/* La Seu on its rocky outcrop */}
				<g fill="#2f2415">
					<path d="M330 520 Q420 420 560 430 Q700 420 760 520 Z" />
					<rect x="430" y="330" width="250" height="110" />
					{Array.from({ length: 6 }, (_, i) => (
						<path d={`M${438 + i * 44} 440 L${438 + i * 44} 320 L${446 + i * 44} 304 L${454 + i * 44} 320 L${454 + i * 44} 440 Z`} />
					))}
					<path d="M430 330 L555 290 L680 330 Z" />
					<rect x="600" y="230" width="58" height="120" />
					<path d="M596 232 L629 206 L662 232 Z" />
					<rect x="610" y="196" width="6" height="16" />
					<rect x="642" y="196" width="6" height="16" />
				</g>
				<g fill="#d9ad52" opacity="0.5">
					<rect x="618" y="252" width="8" height="22" rx="4" />
					<rect x="634" y="252" width="8" height="22" rx="4" />
					<path d="M545 360 a12 12 0 0 1 24 0 v36 h-24 Z" />
				</g>
				{/* River and Pont Vell */}
				<rect x="-470" y="545" width={W + 470} height="40" fill="#b88a3a" opacity="0.35" />
				<path d={bridge} fill="#241b10" fill-rule="evenodd" transform="translate(-120 0)" />
				</g>
				<path d={hills([620, 600, 610, 590, 575, 560, 545])} fill="#1f170e" />
			</g>
		)
	}
	{
		variant === "cardona" && (
			<g>
				<path d={hills([440, 420, 450, 405, 430, 410, 425])} fill="#9a7840" opacity="0.6" />
				{/* Castle hill with the fortress, collegiate church and Torre de la Minyona */}
				<path d="M760 600 Q900 400 1060 372 Q1240 366 1440 470 L1440 600 Z" fill="#5a4222" />
				<g fill="#2f2415">
					<rect x="905" y="300" width="330" height="80" />
					<path d={crenels(905, 300, 330)} />
					<rect x="975" y="262" width="150" height="48" />
					<path d="M970 264 L1050 228 L1130 264 Z" />
					<rect x="935" y="214" width="42" height="96" />
					<path d="M931 216 L956 194 L981 216 Z" />
					<rect x="1160" y="196" width="52" height="120" rx="4" />
					<path d={crenels(1158, 196, 56, 14)} />
				</g>
				<g fill="#d9ad52" opacity="0.5">
					<path d="M1040 290 a10 10 0 0 1 20 0 v20 h-20 Z" />
					<rect x="950" y="236" width="8" height="18" rx="4" />
					<rect x="1180" y="222" width="8" height="18" rx="4" />
				</g>
				{/* Salt mountain */}
				<path d={saltBack.outline} fill="#c4ad85" />
				<path d={salt.outline} fill="#e6d9c2" />
				<g stroke="#b59e74" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.6">
					{salt.gullies.map((d) => <path d={d} />)}
				</g>
				<path d={hills([640, 610, 590, 600, 580, 570, 560])} fill="#241b10" opacity="0.6" />
				<rect x="0" y="590" width={W} height="26" fill="#b88a3a" opacity="0.3" />
				<path d={hills([630, 620, 615, 625, 612, 620, 610])} fill="#1f170e" />
			</g>
		)
	}
</svg>
