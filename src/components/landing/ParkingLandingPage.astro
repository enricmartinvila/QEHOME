---
import LandingHero from "./LandingHero.astro"
import RelatedLandings from "../home/RelatedLandings.astro"
import Contact from "../home/Contact.astro"
import { getTranslations, type Lang } from "../../constants/i18n"
import { PARKING_LANDING } from "../../constants/landings"
import { getLandingDecor } from "../../constants/landingDecor"
import LandingSections from "./LandingSections.astro"
import LandingFaqs from "./LandingFaqs.astro"
import KeyFacts from "./KeyFacts.astro"
import ApartmentPromo from "./ApartmentPromo.astro"
import RevealScript from "./RevealScript.astro"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const page = t.parkingPage
const decor = getLandingDecor("parking")

const features = [
	{ image: PARKING_LANDING.parkingImage, alt: page.parkingImageAlt, title: page.parkingTitle, text: page.parkingText, kind: "parking" },
	{ image: PARKING_LANDING.evImage, alt: page.evImageAlt, title: page.evTitle, text: page.evText, kind: "ev" },
] as const
---

<LandingHero
	lang={lang}
	heroImage={PARKING_LANDING.heroImage}
	h1={page.h1}
	heroSubtitle={page.heroSubtitle}
	breadcrumbHome={page.breadcrumbHome}
	breadcrumbCurrent={page.breadcrumbCurrent}
	ctaLabel={page.ctaLabel}
	overlap
/>

<KeyFacts title={page.keyFacts.title} items={page.keyFacts.items} icons={decor.keyFactIcons} />

<section class="bg-stone-50 pb-16 pt-14 md:pb-24 md:pt-20">
	<div class="mx-auto max-w-4xl px-4">
		<p class="reveal mx-auto max-w-2xl text-center text-2xl font-semibold leading-snug text-stone-900 md:text-3xl">
			{page.benefitLead}
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 md:mt-12 md:grid-cols-2">
			{
				features.map((f) => (
					<article class="reveal overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-sm">
						{f.image ? (
							<img src={f.image} alt={f.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
						) : (
							<div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-gradient-to-br from-stone-900 via-stone-800 to-stone-700" aria-hidden="true">
								{f.kind === "parking" ? (
									<svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice">
										<g stroke="#ffffff" stroke-opacity="0.18" stroke-width="3">
											{[40, 120, 200, 280, 360].map((x) => <line x1={x} y1="150" x2={x} y2="250" />)}
										</g>
										<rect x="135" y="160" width="50" height="80" rx="12" fill="#ECB434" fill-opacity="0.9" />
										<rect x="142" y="172" width="36" height="18" rx="5" fill="#1c1917" fill-opacity="0.55" />
										<rect x="160" y="40" width="80" height="80" rx="18" fill="#ffffff" fill-opacity="0.08" stroke="#ECB434" stroke-width="4" />
										<text x="200" y="102" text-anchor="middle" font-size="58" font-weight="700" fill="#ECB434" font-family="Fira Sans, sans-serif">P</text>
									</svg>
								) : (
									<svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice">
										<circle cx="200" cy="120" r="78" fill="#ECB434" fill-opacity="0.12" />
										<circle cx="200" cy="120" r="54" fill="none" stroke="#ECB434" stroke-width="4" />
										<path d="M206 82 178 126h22l-6 38 28-46h-22z" fill="#ECB434" />
										<path d="M278 120c40 0 30 80 80 80" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="6" stroke-linecap="round" />
									</svg>
								)}
							</div>
						)}
						<div class="p-7 md:p-8">
							<h2 class="text-xl font-bold text-stone-900 md:text-2xl">{f.title}</h2>
							<p class="landing-prose mt-3">{f.text}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-12 md:mt-16">
			<LandingSections lang={lang} sections={page.sections} decor={decor.sections} />
		</div>

		<LandingFaqs title={page.faqsTitle} faqs={page.faqs} />
	</div>

	<ApartmentPromo
		lang={lang}
		title={page.apartmentTitle}
		text={page.apartmentText}
		backHome={page.backHome}
		availabilityNote={page.availabilityNote}
	/>

	<RelatedLandings lang={lang} excludeSlug={PARKING_LANDING.slug} />
</section>

<Contact lang={lang} />
<RevealScript />
