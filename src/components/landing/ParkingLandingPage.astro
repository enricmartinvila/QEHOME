---
import LandingHero from "./LandingHero.astro"
import BookingCtas from "./BookingCtas.astro"
import RelatedLandings from "../home/RelatedLandings.astro"
import Contact from "../home/Contact.astro"
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import { PARKING_LANDING } from "../../constants/landings"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const page = t.parkingPage
const slug = PARKING_LANDING.slug
const parkingImage = PARKING_LANDING.parkingImage
const evImage = PARKING_LANDING.evImage
---

<LandingHero
	lang={lang}
	heroImage={PARKING_LANDING.heroImage}
	h1={page.h1}
	heroSubtitle={page.heroSubtitle}
	breadcrumbHome={page.breadcrumbHome}
	breadcrumbCurrent={page.breadcrumbCurrent}
	ctaLabel={page.ctaLabel}
/>

<section class="bg-stone-50 py-14 md:py-20">
	<div class="mx-auto max-w-5xl px-4">
		{
			page.benefitLead && (
				<header class="landing-reveal mx-auto max-w-3xl text-center">
					<p class="text-xl font-semibold leading-relaxed text-stone-900 md:text-2xl">
						{page.benefitLead}
					</p>
				</header>
			)
		}

		<div class="mt-10 grid grid-cols-1 gap-6 md:mt-12 md:grid-cols-2 md:gap-8">
			<article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
				{
					parkingImage ? (
						<img
							src={parkingImage}
							alt={page.parkingImageAlt}
							class="aspect-[4/3] w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<div
							class="flex aspect-[4/3] items-center justify-center bg-stone-100"
							aria-hidden="true"
						>
							<svg class="h-14 w-14 text-brand/60" viewBox="0 0 24 24" fill="currentColor">
								<path d="M5.25 6A2.25 2.25 0 0 0 3 8.25v7.5A2.25 2.25 0 0 0 5.25 18h.75a2.25 2.25 0 0 1 4.5 0h3a2.25 2.25 0 0 1 4.5 0h.75A2.25 2.25 0 0 0 21 15.75v-1.5h-7.5V6H5.25Z" />
								<path d="M15 6v6.75h6v-4.5A2.25 2.25 0 0 0 18.75 6H15Z" />
							</svg>
						</div>
					)
				}
				<div class="p-7 md:p-8">
					<h2 class="text-xl font-bold text-stone-900 md:text-2xl">
						{page.parkingTitle}
					</h2>
					<p class="landing-prose mt-4">{page.parkingText}</p>
				</div>
			</article>
			<article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
				{
					evImage ? (
						<img
							src={evImage}
							alt={page.evImageAlt}
							class="aspect-[4/3] w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<div
							class="flex aspect-[4/3] items-center justify-center bg-stone-100"
							aria-hidden="true"
						>
							<svg class="h-14 w-14 text-brand/60" viewBox="0 0 24 24" fill="currentColor">
								<path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z" clip-rule="evenodd" />
							</svg>
						</div>
					)
				}
				<div class="p-7 md:p-8">
					<h2 class="text-xl font-bold text-stone-900 md:text-2xl">
						{page.evTitle}
					</h2>
					<p class="landing-prose mt-4">{page.evText}</p>
				</div>
			</article>
		</div>

		{
			page.facts?.length > 0 && (
				<section class="mx-auto mt-14 max-w-3xl md:mt-16">
					<h2 class="landing-section-title text-center">{page.factsTitle}</h2>
					<dl class="mt-8 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
						{page.facts.map((fact) => (
							<div class="grid gap-2 border-b border-stone-200 p-6 last:border-b-0 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] sm:gap-8">
								<dt class="font-semibold text-stone-900">{fact.q}</dt>
								<dd class="landing-prose">{fact.a}</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		<aside class="mx-auto mt-10 max-w-3xl rounded-2xl bg-brand p-8 text-white shadow-sm md:mt-12 md:p-10">
			<div class="grid items-center gap-7 md:grid-cols-[1fr_auto] md:gap-10">
				<div>
					<h2 class="text-2xl font-bold md:text-3xl">{page.apartmentTitle}</h2>
					<p class="mt-3 max-w-xl text-[15px] leading-relaxed text-white/90 md:text-base">
						{page.apartmentText}
					</p>
				</div>
				<a
					href={localizedPath(lang)}
					class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-stone-900 transition hover:bg-stone-100"
				>
					{page.backHome}
				</a>
			</div>
		</aside>
	</div>

	<BookingCtas heading={page.availabilityNote} />
	<RelatedLandings lang={lang} excludeSlug={slug} />
</section>

<Contact lang={lang} />
