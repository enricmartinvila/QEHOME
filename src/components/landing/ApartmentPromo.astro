---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import { AIRBNB_URL, BOOKING_URL } from "../../constants/links"
import Icon from "./Icon.astro"
import type { IconName } from "./icons"

interface Props {
	lang: Lang
	title: string
	text: string
	backHome: string
	availabilityNote?: string
}

const { lang, title, text, backHome, availabilityNote } = Astro.props
const t = getTranslations(lang)
const photos = t.gallery.photos
const rating = t.maintexts.rating
const equipmentIcons: Record<string, IconName> = {
	bed: "bed",
	kitchen: "kitchen",
	living: "home",
	wifi: "wifi",
	desk: "briefcase",
	parking: "car",
	charger: "bolt",
	key: "key",
}
---

<section id="apartamento" class="reveal mx-auto mt-16 max-w-6xl scroll-mt-28 px-4 md:mt-20">
	<div class="grid overflow-hidden rounded-[2rem] bg-stone-900 text-white shadow-2xl shadow-stone-900/20 lg:grid-cols-[1.05fr_1fr]">
		<div class="grid grid-cols-2 grid-rows-2 gap-1.5 p-1.5 lg:min-h-[520px]">
			<img
				src="/images/menjador12.webp"
				alt={photos.menjador12.alt}
				class="col-span-2 h-full max-h-80 w-full rounded-t-[1.6rem] object-cover lg:col-span-1 lg:row-span-2 lg:max-h-none lg:rounded-l-[1.6rem] lg:rounded-tr-none"
				loading="lazy"
				decoding="async"
			/>
			<img
				src="/images/hab2.webp"
				alt={photos.hab2.alt}
				class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto lg:rounded-tr-[1.6rem]"
				loading="lazy"
				decoding="async"
			/>
			<img
				src="/images/cuina2.webp"
				alt={photos.cuina2.alt}
				class="aspect-[4/3] h-full w-full object-cover"
				loading="lazy"
				decoding="async"
			/>
		</div>

		<div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
			<div class="flex flex-wrap gap-2 text-sm">
				<span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-medium">
					<Icon name="star" class="h-4 w-4 fill-brand-cta text-brand-cta" />
					{rating.booking.score} {rating.booking.label}
				</span>
				<span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-medium">
					<Icon name="star" class="h-4 w-4 fill-brand-cta text-brand-cta" />
					{rating.airbnb.score} {rating.airbnb.label}
				</span>
			</div>
			<h2 class="mt-5 text-3xl font-bold leading-tight md:text-4xl">{title}</h2>
			<p class="mt-4 text-[15px] leading-relaxed text-white/80 md:text-base">{text}</p>

			<ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm text-white/90">
				{
					t.equipment.items.map((item) => (
						<li class="flex items-center gap-2.5">
							<Icon name={equipmentIcons[item.icon] ?? "check"} class="h-4 w-4 flex-shrink-0 text-brand-cta" />
							{item.label}
						</li>
					))
				}
			</ul>

			{availabilityNote && <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-brand-cta">{availabilityNote}</p>}
			<div class="mt-3 flex flex-wrap gap-3">
				<a
					href={BOOKING_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue-500"
				>
					{t.bookingCtas.bookingLabel}
				</a>
				<a
					href={AIRBNB_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center rounded-full bg-[#FF5A5F] px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#FF7A7F]"
				>
					{t.bookingCtas.airbnbLabel}
				</a>
				<a
					href={localizedPath(lang)}
					class="inline-flex items-center justify-center gap-1.5 rounded-full border border-white/25 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
				>
					{backHome}
					<Icon name="arrow" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</div>
</section>
