---
interface Props {
	title: string
	items: Array<{ label: string; value: string }>
}

const { title, items } = Astro.props
---

<section class="mb-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm md:p-8">
	<h2 class="text-lg font-bold text-stone-900 md:text-xl">{title}</h2>
	<dl class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
		{
			items.map((item) => (
				<div class="border-l-2 border-brand/40 pl-4">
					<dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">{item.label}</dt>
					<dd class="mt-1 text-[15px] font-medium leading-snug text-stone-900">{item.value}</dd>
				</div>
			))
		}
	</dl>
</section>
