---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"

interface Props {
	lang: Lang
	heroImage: string
	h1: string
	heroSubtitle: string
	breadcrumbHome: string
	breadcrumbCurrent: string
	ctaLabel?: string
	ctaHref?: string
	secondaryCtaLabel?: string
	secondaryCtaHref?: string
}

const {
	lang,
	heroImage,
	h1,
	heroSubtitle,
	breadcrumbHome,
	breadcrumbCurrent,
	ctaLabel,
	ctaHref = "#contacto",
	secondaryCtaLabel,
	secondaryCtaHref = localizedPath(lang),
} = Astro.props
const t = getTranslations(lang)
const label = ctaLabel || t.titles.book_now
---

<section
	class="relative flex min-h-[68vh] flex-col items-center justify-center overflow-hidden bg-cover bg-center bg-no-repeat pt-20 text-white md:min-h-[72vh]"
	style={`background-image: url('${heroImage}')`}
>
	<div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/45 to-black/60"></div>

	<div class="relative z-10 mx-auto w-full max-w-4xl px-6 py-16 text-center">
		<nav
			class="landing-reveal mb-7 text-sm text-white/80"
			aria-label="Breadcrumb"
		>
			<a href={localizedPath(lang)} class="transition hover:text-white">{breadcrumbHome}</a>
			<span class="mx-2 text-white/45" aria-hidden="true">/</span>
			<span class="text-white" aria-current="page">{breadcrumbCurrent}</span>
		</nav>

		<h1
			class="landing-reveal landing-reveal-delay-1 text-3xl font-bold leading-tight drop-shadow-lg sm:text-4xl lg:text-5xl"
		>
			{h1}
		</h1>

		<p
			class="landing-reveal landing-reveal-delay-2 mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/95 drop-shadow-md sm:text-xl"
		>
			{heroSubtitle}
		</p>

		<div
			class="landing-reveal landing-reveal-delay-3 mt-9 flex flex-wrap items-center justify-center gap-3 sm:gap-4"
		>
			<a
				href={ctaHref}
				class="inline-flex items-center justify-center rounded-full bg-brand-cta px-8 py-3 text-lg font-semibold text-white shadow-lg transition hover:bg-brand-ctaHover focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ECB434]/60"
			>
				{label}
			</a>
			{
				secondaryCtaLabel && (
					<a
						href={secondaryCtaHref}
						class="inline-flex items-center justify-center rounded-full border border-white/40 bg-white/10 px-7 py-3 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
					>
						{secondaryCtaLabel}
					</a>
				)
			}
		</div>
	</div>
</section>
