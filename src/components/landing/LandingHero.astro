---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import type { IllustrationVariant } from "../../constants/landingDecor"
import LandingIllustration from "./LandingIllustration.astro"
import Icon from "./Icon.astro"

interface Props {
	lang: Lang
	heroImage: string
	illustration?: IllustrationVariant
	h1: string
	heroSubtitle: string
	breadcrumbHome: string
	breadcrumbCurrent: string
	ctaLabel?: string
	ctaHref?: string
	secondaryCtaLabel?: string
	secondaryCtaHref?: string
	/** Extra chips under the CTAs, e.g. reading time or review date */
	meta?: string[]
	/** Leave room at the bottom for an overlapping key-facts card */
	overlap?: boolean
}

const {
	lang,
	heroImage,
	illustration,
	h1,
	heroSubtitle,
	breadcrumbHome,
	breadcrumbCurrent,
	ctaLabel,
	ctaHref = "#contacto",
	secondaryCtaLabel,
	secondaryCtaHref = localizedPath(lang),
	meta = [],
	overlap = false,
} = Astro.props
const t = getTranslations(lang)
const label = ctaLabel || t.titles.book_now
const rating = t.maintexts.rating
---

<section
	class:list={[
		"relative isolate flex min-h-[78vh] items-end overflow-hidden pt-28 text-white md:min-h-[72vh] md:items-center",
		overlap ? "pb-32 md:pb-36" : "pb-16",
		illustration ? "bg-[#1c1712]" : "bg-night",
	]}
>
	{
		illustration ? (
			<div class="absolute inset-x-0 bottom-0 -z-10 h-[60%] md:h-full">
				<LandingIllustration variant={illustration} class="h-full w-full" />
			</div>
		) : (
			<img
				src={heroImage}
				alt=""
				class="absolute inset-0 -z-10 h-full w-full object-cover"
				fetchpriority="high"
				decoding="async"
			/>
		)
	}
	<div
		class:list={[
			"absolute inset-0 -z-10",
			illustration
				? "bg-gradient-to-r from-black/55 via-black/20 to-transparent"
				: "bg-gradient-to-t from-black/80 via-black/50 to-black/30 md:bg-gradient-to-r md:from-black/80 md:via-black/50 md:to-black/10",
		]}
	>
	</div>

	<div class="mx-auto w-full max-w-6xl px-4">
		<div class="max-w-2xl">
			<nav class="landing-reveal mb-6 flex flex-wrap items-center gap-2 text-sm text-white/75" aria-label="Breadcrumb">
				<a href={localizedPath(lang)} class="transition hover:text-white">{breadcrumbHome}</a>
				<span class="text-white/40" aria-hidden="true">/</span>
				<span class="text-white" aria-current="page">{breadcrumbCurrent}</span>
			</nav>

			<h1 class="landing-reveal landing-reveal-delay-1 text-[2rem] font-bold leading-[1.12] tracking-tight drop-shadow-lg sm:text-5xl lg:text-[3.4rem]">
				{h1}
			</h1>

			<p class="landing-reveal landing-reveal-delay-2 mt-5 max-w-xl text-lg leading-relaxed text-white/90 drop-shadow md:text-xl">
				{heroSubtitle}
			</p>

			<div class="landing-reveal landing-reveal-delay-3 mt-8 flex flex-wrap items-center gap-3">
				<a
					href={ctaHref}
					class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-cta px-7 py-3.5 text-base font-semibold text-ink shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-brand-ctaHover focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ECB434]/60"
				>
					{label}
					<Icon name="arrow" class="h-4 w-4" />
				</a>
				{
					secondaryCtaLabel && (
						<a
							href={secondaryCtaHref}
							class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/10 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
						>
							{secondaryCtaLabel}
						</a>
					)
				}
			</div>

			<ul class="landing-reveal landing-reveal-delay-3 mt-8 flex flex-wrap gap-2 text-sm">
				<li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 font-medium ring-1 ring-white/20 backdrop-blur-sm">
					<Icon name="star" class="h-4 w-4 fill-brand-cta text-brand-cta" />
					{rating.booking.score} · {rating.booking.label}
				</li>
				<li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 font-medium ring-1 ring-white/20 backdrop-blur-sm">
					<Icon name="star" class="h-4 w-4 fill-brand-cta text-brand-cta" />
					{rating.airbnb.score} · {rating.airbnb.label}
				</li>
				{
					meta.map((m) => (
						<li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 font-medium ring-1 ring-white/20 backdrop-blur-sm">
							<Icon name="book" class="h-4 w-4" />
							{m}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
