---
import LandingHero from "./LandingHero.astro"
import RelatedLandings from "../home/RelatedLandings.astro"
import Contact from "../home/Contact.astro"
import { getTranslations, type Lang } from "../../constants/i18n"
import { getTopicLanding, type TopicLandingKey } from "../../constants/landings"
import { getLandingDecor } from "../../constants/landingDecor"
import { MONTSERRAT_NOTICES } from "../../constants/montserratNotices"
import LandingSections, { type LandingSection } from "./LandingSections.astro"
import LandingFaqs from "./LandingFaqs.astro"
import LandingToc from "./LandingToc.astro"
import KeyFacts from "./KeyFacts.astro"
import ApartmentPromo from "./ApartmentPromo.astro"
import RevealScript from "./RevealScript.astro"
import Icon from "./Icon.astro"
import LocationCard from "./LocationCard.astro"

interface Props {
	lang: Lang
	landingKey: TopicLandingKey
}

const { lang, landingKey } = Astro.props
const landing = getTopicLanding(landingKey)
if (!landing) throw new Error(`Unknown landing key: ${landingKey}`)
const decor = getLandingDecor(landingKey)

const t = getTranslations(lang)
const page = t[landing.pageKey as keyof typeof t] as {
	h1: string
	heroSubtitle: string
	ctaLabel?: string
	secondaryCtaLabel?: string
	breadcrumbHome: string
	breadcrumbCurrent: string
	sections: LandingSection[]
	keyFacts?: { title: string; items: Array<{ label: string; value: string }> }
	toc?: Array<{ id: string; label: string }>
	reviewedLabel?: string
	showAboutGuide?: boolean
	beforeLeave?: { title: string; text: string }
	temporaryNotices?: { funiculars?: string }
	faqs?: Array<{ q: string; a: string }>
	faqsTitle?: string
	availabilityNote?: string
	apartmentTitle: string
	apartmentText: string
	backHome: string
	relatedTitle?: string
	relatedKeys?: string[]
}

const guideUi = t.guideUi
const aboutGuide = t.aboutGuide

const activeFunicularNotice =
	landingKey === "montserrat" &&
	MONTSERRAT_NOTICES.temporary.some((n) => n.id === "funiculars" && n.active)
		? page.temporaryNotices?.funiculars
		: null

const toc = page.toc?.length ? page.toc : null

// Reading time for guides (~220 words per minute)
const words = JSON.stringify([page.sections, page.faqs ?? []])
	.replace(/"[a-zA-Z]+":/g, " ")
	.split(/\s+/).length
const readingMinutes = Math.max(2, Math.round(words / 220))
const meta = toc ? [guideUi.readingTime.replace("{n}", String(readingMinutes))] : []
---

<LandingHero
	lang={lang}
	heroImage={landing.heroImage}
	illustration={decor.illustration}
	h1={page.h1}
	heroSubtitle={page.heroSubtitle}
	breadcrumbHome={page.breadcrumbHome}
	breadcrumbCurrent={page.breadcrumbCurrent}
	ctaLabel={page.ctaLabel}
	secondaryCtaLabel={page.secondaryCtaLabel}
	meta={meta}
	overlap={Boolean(page.keyFacts)}
/>

{page.keyFacts && <KeyFacts title={page.keyFacts.title} items={page.keyFacts.items} icons={decor.keyFactIcons} />}

<section class="bg-paper pb-16 pt-12 md:pb-24 md:pt-16">
	<div
		class:list={[
			"mx-auto px-4",
			toc ? "max-w-6xl lg:grid lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-12" : "max-w-4xl",
		]}
	>
		{
			toc && (
				<LandingToc
					lang={lang}
					title={guideUi.title}
					items={toc}
					reviewedLabel={page.reviewedLabel}
					ctaLabel={page.ctaLabel || t.titles.book_now}
				/>
			)
		}

		<div class="min-w-0">
			{
				page.beforeLeave && (
					<aside class="reveal mb-8 flex gap-4 rounded-3xl border border-amber-200 bg-amber-50 p-6 md:p-7">
						<span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-white text-amber-600 shadow-sm">
							<Icon name="info" class="h-6 w-6" />
						</span>
						<div>
							<h2 class="text-lg font-bold text-ink">{page.beforeLeave.title}</h2>
							<p class="landing-prose mt-2">{page.beforeLeave.text}</p>
							{activeFunicularNotice && (
								<p class="mt-3 rounded-xl bg-white/70 px-4 py-3 text-[15px] font-medium text-stone-800">
									{activeFunicularNotice}
								</p>
							)}
						</div>
					</aside>
				)
			}

			<LandingSections lang={lang} sections={page.sections} decor={decor.sections} />

			{decor.location && <LocationCard lang={lang} />}

			{page.faqs && <LandingFaqs title={page.faqsTitle} faqs={page.faqs} />}

			{
				page.showAboutGuide && (
					<section class="reveal mt-10 flex gap-4 rounded-3xl border border-dashed border-stone-300 p-6 md:p-8">
						<img src="/logo/logoshort.webp" alt="" class="h-11 w-11 flex-shrink-0 rounded-2xl bg-night object-contain p-2" loading="lazy" />
						<div>
							<h2 class="text-lg font-bold text-ink">{aboutGuide.title}</h2>
							<p class="landing-prose mt-2">{aboutGuide.text}</p>
							{page.reviewedLabel && <p class="mt-3 text-sm font-medium text-stone-500">{page.reviewedLabel}</p>}
						</div>
					</section>
				)
			}
		</div>
	</div>

	<ApartmentPromo
		lang={lang}
		title={page.apartmentTitle}
		text={page.apartmentText}
		backHome={page.backHome}
		availabilityNote={page.availabilityNote}
	/>

	<RelatedLandings lang={lang} excludeSlug={landing.slug} includeKeys={page.relatedKeys} title={page.relatedTitle} />
</section>

<Contact lang={lang} />
<RevealScript />
