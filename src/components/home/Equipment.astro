---

<section class="bg-white py-14 md:py-16">
	<div class="mx-auto max-w-5xl px-4">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">{eq.title}</h2>
			<p class="mt-4 text-[15px] leading-relaxed text-stone-600 md:text-base">
				{eq.intro}
			</p>
		</div>
		<ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 md:gap-5">
			{
				eq.items.map((item) => (
					<li class="flex flex-col items-center rounded-2xl border border-stone-200 bg-stone-50 px-4 py-5 text-center">
						<span class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-brand/10 text-brand">
							<svg
								class="h-6 w-6"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d={icons[item.icon] || icons.key}
								/>
							</svg>
						</span>
						<span class="text-sm font-medium text-stone-800">{item.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
