---

<section class="bg-night py-[74px] text-white lg:py-[100px]">
	<div class="mx-auto grid max-w-[1180px] items-center gap-11 px-5 sm:px-7 lg:grid-cols-2 lg:gap-20">
		<div class="reveal">
			<span class="kicker !text-brand-cta">{ui.kickers.apartment}</span>
			<h2 class="mb-5 text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{eq.title}</h2>
			<p class="max-w-[560px] text-[1.12rem] leading-relaxed text-[#a9afb8]">{eq.intro}</p>
		</div>
		<ul class="reveal grid gap-3.5 sm:grid-cols-2">
			{
				eq.items.map((item) => (
					<li class="flex items-center gap-3.5 rounded-2xl border border-white/[0.06] bg-night-2 px-6 py-[22px] font-medium transition duration-200 hover:-translate-y-[3px] hover:border-brand-cta">
						<span class="grid h-[38px] w-[38px] flex-none place-items-center rounded-full bg-brand-cta/15 text-brand-cta">
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon] || icons.key} />
							</svg>
						</span>
						{item.label}
					</li>
				))
			}
		</ul>
	</div>
</section>
