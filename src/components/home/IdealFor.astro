---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import { getTopicLanding } from "../../constants/landings"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const ideal = t.idealFor
const familias = getTopicLanding("familias")!
const familiesHref = localizedPath(lang, familias.slug)
---

<section class="bg-white py-12 md:py-16">
	<div class="mx-auto max-w-4xl px-4 text-center">
		<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">{ideal.title}</h2>
		<p class="mt-4 text-[15px] leading-relaxed text-stone-600 md:text-base">
			{ideal.families}
		</p>
		<p class="mt-3 text-[15px] leading-relaxed text-stone-600 md:text-base">
			{ideal.work}
		</p>
		<ul class="mt-8 flex flex-wrap justify-center gap-3">
			{
				ideal.items.map((item) => (
					<li class="rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-sm text-stone-700">
						{item}
					</li>
				))
			}
		</ul>
		{
			ideal.familiesLink && (
				<div class="mt-8">
					<a
						href={familiesHref}
						class="text-base font-medium text-brand hover:underline"
					>
						{ideal.familiesLink}
					</a>
				</div>
			)
		}
	</div>
</section>
