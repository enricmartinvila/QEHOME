---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import { PARKING_LANDING } from "../../constants/landings"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const items = t.aboutustexts.differentiators
const parkingHref = localizedPath(lang, PARKING_LANDING.slug)
---

<section class="py-[74px] lg:py-[100px]">
	<div class="mx-auto max-w-[1180px] px-5 sm:px-7">
		<div class="reveal">
			<span class="kicker">{t.homeUi.kickers.why}</span>
			<h2 class="mb-5 max-w-[640px] text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{t.homeUi.whyTitle}</h2>
		</div>
		<div class="mt-5 grid border-t border-[#e2ded4] lg:grid-cols-3">
			{
				items.map((item, i) => (
					<div
						class:list={[
							"reveal border-b border-[#e2ded4] py-[30px] lg:border-b-0 lg:py-11",
							i < items.length - 1 && "lg:border-r",
							i === 0 ? "lg:pr-[38px]" : "lg:px-[38px]",
						]}
					>
						<div class="mb-3.5 font-serif text-5xl leading-none text-brand-cta">{String(i + 1).padStart(2, "0")}</div>
						<h3 class="mb-2 font-serif text-[1.45rem] leading-[1.08]">{item.title}</h3>
						<p class="text-[0.97rem] leading-relaxed text-[#646a73]">{item.description}</p>
						{i === 0 && <a href={parkingHref} class="more-link">{t.differentiatorsLink} →</a>}
					</div>
				))
			}
		</div>
	</div>
</section>
