---
import { getTranslations, type Lang } from "../../constants/i18n"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const info = t.practicalInfo
const ui = t.homeUi
---

<section id="info" class="scroll-mt-24 bg-sand py-[74px] lg:py-[100px]">
	<div class="mx-auto grid max-w-[1180px] gap-11 px-5 sm:px-7 lg:grid-cols-[1fr_1.7fr] lg:gap-20">
		<div class="reveal">
			<span class="kicker">{ui.kickers.info}</span>
			<h2 class="text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{ui.infoTitle}</h2>
		</div>
		<dl class="reveal grid gap-x-10 sm:grid-cols-2">
			{
				info.items.map((item) => (
					<div class="border-b border-[#d6d1c4] py-[26px]">
						<dt class="mb-2 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-brand">{item.title}</dt>
						<dd class="text-[0.97rem] leading-relaxed text-[#3d424a]">{item.text}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
