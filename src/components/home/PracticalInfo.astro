---
import { getTranslations, type Lang } from "../../constants/i18n"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const info = getTranslations(lang).practicalInfo
---

<section id="info" class="scroll-mt-24 bg-stone-50 py-14 md:py-16">
	<div class="mx-auto max-w-5xl px-4">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">{info.title}</h2>
			<p class="mt-4 text-[15px] leading-relaxed text-stone-600 md:text-base">{info.intro}</p>
		</div>
		<dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
			{
				info.items.map((item) => (
					<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
						<dt class="text-base font-bold text-stone-900">{item.title}</dt>
						<dd class="landing-prose mt-2">{item.text}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
