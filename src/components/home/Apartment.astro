---
import { getTranslations, type Lang } from "../../constants/i18n"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
---

<section id="descripcionID" class="bg-brand py-14 text-white md:py-20">
	<div class="mx-auto max-w-3xl px-4 text-center">
		<h2 class="mb-8 text-3xl font-bold md:mb-10 md:text-4xl">{t.titles.aboutus}</h2>
		<p class="text-lg leading-relaxed text-white/95">{t.aboutustexts.intro}</p>
		<ul class="mt-8 space-y-3 text-left text-[15px] leading-relaxed sm:mx-auto sm:max-w-md">
			{
				t.aboutustexts.highlights.map((item) => (
					<li class="flex gap-3">
						<span class="mt-2 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-white/85" />
						<span>{item}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
