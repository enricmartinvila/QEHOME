---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import {
	PARKING_LANDING,
	TOPIC_LANDINGS_CONFIG,
} from "../../constants/landings"

interface Props {
	lang: Lang
	excludeSlug?: string
}

const { lang, excludeSlug } = Astro.props
const t = getTranslations(lang)
const labels = t.relatedLandings.labels

const allLandings = [PARKING_LANDING, ...TOPIC_LANDINGS_CONFIG]
const links = allLandings.filter((l) => l.slug !== excludeSlug)
---

<nav class="mx-auto mt-16 max-w-3xl px-4" aria-label={t.relatedLandings.title}>
	<h2 class="text-center text-xl font-bold text-stone-900 md:text-2xl">
		{t.relatedLandings.title}
	</h2>
	<ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
		{
			links.map((landing) => (
				<li>
					<a
						href={localizedPath(lang, landing.slug)}
						class="group landing-related-card"
					>
						<span class="flex items-center justify-between gap-3">
							<span>{labels[landing.key as keyof typeof labels]}</span>
							<span class="text-brand transition group-hover:translate-x-0.5" aria-hidden="true">
								→
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
