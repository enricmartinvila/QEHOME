---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import {
	PARKING_LANDING,
	TOPIC_LANDINGS_CONFIG,
} from "../../constants/landings"

interface Props {
	lang: Lang
	excludeSlug?: string
}

const { lang, excludeSlug } = Astro.props
const t = getTranslations(lang)
const labels = t.relatedLandings.labels

const allLandings = [PARKING_LANDING, ...TOPIC_LANDINGS_CONFIG]
const links = allLandings.filter((l) => l.slug !== excludeSlug)
---

<nav class="mx-auto mt-16 max-w-3xl px-4" aria-label={t.relatedLandings.title}>
	<h2 class="text-center text-lg font-semibold text-stone-900">
		{t.relatedLandings.title}
	</h2>
	<ul class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-3 text-sm">
		{
			links.map((landing) => (
				<li>
					<a
						href={localizedPath(lang, landing.slug)}
						class="text-stone-600 underline decoration-stone-300 underline-offset-4 transition hover:text-brand hover:decoration-brand"
					>
						{labels[landing.key as keyof typeof labels]}
					</a>
				</li>
			))
		}
	</ul>
</nav>
