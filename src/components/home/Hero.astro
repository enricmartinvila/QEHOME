---
import BookingBar from "../BookingBar.astro"
import { getTranslations, type Lang } from "../../constants/i18n"
import { AIRBNB_URL, BOOKING_URL, DIRECT_BOOKING } from "../../constants/links"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const m = t.maintexts
const ui = t.homeUi
const [before, after] = m.headline.includes(ui.heroHighlight)
	? m.headline.split(ui.heroHighlight)
	: [m.headline, null]
const ratings = [
	{ ...m.rating.booking, href: BOOKING_URL },
	...(DIRECT_BOOKING ? [] : [{ ...m.rating.airbnb, href: AIRBNB_URL }]),
]
---

<section
	class="relative flex min-h-screen items-center justify-center bg-cover bg-center px-5 pb-[90px] pt-[120px] text-center text-white"
	style="background-image: linear-gradient(180deg, rgba(21,24,29,.7), rgba(21,24,29,.55) 50%, rgba(21,24,29,.9)), url('/images/menjador12.webp')"
>
	<div class="mx-auto max-w-[1180px]">
		<h1 class="mx-auto mb-8 max-w-[900px] text-[clamp(2.8rem,7vw,5.8rem)] leading-[1.08]">
			{before}{after !== null && <em class="text-brand-cta">{ui.heroHighlight}</em>}{after}
		</h1>
		<div class="mb-8 flex flex-wrap justify-center gap-4">
			{
				ratings.map((r) => (
					<a
						href={r.href}
						target="_blank"
						rel="noopener noreferrer"
						class="min-w-[150px] rounded-[18px] border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md transition hover:bg-white/20 sm:min-w-[190px] sm:px-7 sm:py-3.5"
					>
						<b class="block text-[1.6rem] font-semibold"><i class="mr-1 not-italic text-brand-cta">★</i>{r.score}</b>
						<small class="text-[0.82rem] opacity-80">{r.label} · {r.guests}</small>
					</a>
				))
			}
		</div>
		<p class="mx-auto max-w-[620px] text-[1.15rem] opacity-90">{m.subtitle}</p>
		<p class="mx-auto mt-1.5 max-w-[620px] opacity-80">{m.location}</p>
		<div class="mb-9 mt-7 flex flex-wrap justify-center gap-2.5">
			{m.badges.map((badge) => <span class="rounded-full border border-white/35 px-[18px] py-[7px] text-[0.85rem]">{badge}</span>)}
		</div>
		{DIRECT_BOOKING ? <BookingBar lang={lang} /> : <a href="#contacto" class="btn btn-amber">{t.titles.book_now}</a>}
	</div>
</section>
