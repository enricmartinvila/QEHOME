---
import { getTranslations, type Lang } from "../../constants/i18n"
import {
	ADDRESS,
	AIRBNB_URL,
	BOOKING_URL,
	CAL_MASSES_URL,
	EMAIL,
	MAPS_URL,
	PHONE_DISPLAY,
	PHONE_TEL,
	WHATSAPP_URL,
} from "../../constants/links"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const ui = t.homeUi
const [before, after] = t.contacto.check.includes(ui.contactHighlight)
	? t.contacto.check.split(ui.contactHighlight)
	: [t.contacto.check, null]
const contactLinks = [
	{
		href: MAPS_URL,
		label: ADDRESS,
		external: true,
		icon: "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z",
	},
	{
		href: `mailto:${EMAIL}`,
		label: EMAIL,
		external: false,
		icon: "M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75",
	},
	{
		href: `tel:${PHONE_TEL}`,
		label: PHONE_DISPLAY,
		external: false,
		icon: "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z",
	},
	{
		href: WHATSAPP_URL,
		label: "WhatsApp",
		external: true,
		icon: "M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z",
	},
]
---

<section id="contacto" class="scroll-mt-20 bg-night py-[74px] text-white lg:py-[100px]">
	<div class="mx-auto max-w-[1180px] px-5 sm:px-7">
		<div class="grid items-center gap-11 lg:grid-cols-2 lg:gap-20">
			<div class="reveal">
				<span class="kicker !text-brand-cta">{ui.kickers.contact}</span>
				<h2 class="mb-5 text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">
					{before}{after !== null && <em class="text-brand-cta">{ui.contactHighlight}</em>}{after}
				</h2>
				<p class="max-w-[560px] text-[1.12rem] leading-relaxed text-[#a9afb8]">{t.contacto.checkLead}</p>
				<div class="mt-8 grid gap-3 text-[1.02rem]">
					<b class="mb-1.5 block font-serif text-[1.6rem] font-normal">Quico</b>
					{
						contactLinks.map((c) => (
							<a href={c.href} {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="flex items-center gap-3 transition hover:text-brand-cta">
								<svg class="h-5 w-5 flex-shrink-0 text-brand-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
								</svg>
								{c.label}
							</a>
						))
					}
				</div>
			</div>
			<div class="reveal rounded-[28px] border border-white/[0.08] bg-night-2 px-[26px] py-[34px] sm:px-[42px] sm:py-12">
				<h3 class="mb-3 font-serif text-[1.9rem] leading-[1.08]">{ui.bookTitle}</h3>
				<p class="mb-7 text-[#a9afb8]">{ui.bookText}</p>
				<a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-amber mb-3 w-full">{t.contacto.bookingLabel || t.bookingCtas.bookingLabel}</a>
				<a href={AIRBNB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-full">{t.contacto.airbnbLabel || t.bookingCtas.airbnbLabel}</a>
			</div>
		</div>
		<div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-7 text-[#a9afb8]">
			<span>{t.contacto.crossSell} {t.contacto.crossSellLink}.</span>
			<a href={CAL_MASSES_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{ui.explore}</a>
		</div>
	</div>
</section>
