---
import { getTranslations, type Lang } from "../../constants/i18n"
import { localizedPath } from "../../constants/site"
import { PARKING_LANDING, TOPIC_LANDINGS_CONFIG } from "../../constants/landings"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const faq = t.homeFaq
const ui = t.homeUi
const labels = t.relatedLandings.labels as Record<string, string>
const guides = [PARKING_LANDING, ...TOPIC_LANDINGS_CONFIG].map((l) => ({
	href: localizedPath(lang, l.slug),
	label: labels[l.key] ?? l.slug,
}))
---

<section class="py-[74px] lg:py-[100px]" aria-labelledby="home-faq-title">
	<div class="mx-auto grid max-w-[1180px] gap-11 px-5 sm:px-7 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
		<div class="reveal">
			<span class="kicker">{ui.kickers.faq}</span>
			<h2 id="home-faq-title" class="mb-5 text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{ui.faqTitle}</h2>
			<p class="max-w-[560px] text-[1.12rem] leading-relaxed text-[#646a73]">{faq.intro}</p>
			<nav class="mt-9 flex flex-wrap gap-2.5" aria-label={t.relatedLandings.title}>
				{
					guides.map((g) => (
						<a href={g.href} class="rounded-full border-[1.5px] border-[#e2ded4] px-[18px] py-[9px] text-[0.88rem] font-medium transition hover:border-brand-cta hover:bg-white">
							{g.label}
						</a>
					))
				}
			</nav>
		</div>
		<div class="reveal">
			{
				faq.items.map((item) => (
					<details class="group border-b border-[#e2ded4] py-[22px]">
						<summary class="flex cursor-pointer list-none justify-between gap-5 text-[1.05rem] font-semibold marker:content-none [&::-webkit-details-marker]:hidden">
							<span>{item.q}</span>
							<span class="text-2xl leading-none text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="mt-3 text-[0.97rem] leading-relaxed text-[#646a73]">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
