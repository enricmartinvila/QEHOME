---
import { getTranslations, type Lang } from "../../constants/i18n"
import { BOOKING_URL } from "../../constants/links"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
---

<section class="bg-sand py-[74px] lg:py-[100px]">
	<div class="mx-auto max-w-[1180px] px-5 sm:px-7">
		<div class="reveal mb-11 flex flex-wrap items-end justify-between gap-8">
			<div>
				<span class="kicker">{t.homeUi.kickers.reviews}</span>
				<h2 class="text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{t.reviews.title}</h2>
			</div>
			<a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-line">{t.reviews.cta}</a>
		</div>
		<div class="grid gap-[22px] lg:grid-cols-3">
			{
				t.reviews.items.map((review) => (
					<figure class="reveal flex flex-col gap-[18px] rounded-[20px] bg-white px-[30px] py-[34px]">
						<span class="self-start rounded-full bg-night px-3 py-[5px] text-[0.8rem] font-semibold text-brand-cta">{review.score}/10</span>
						<blockquote class="flex-1 font-serif text-[1.28rem] leading-[1.35]">“{review.quote}”</blockquote>
						<figcaption class="text-[0.9rem] font-semibold text-[#646a73]">{review.author}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
