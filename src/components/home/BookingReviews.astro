---
import { getTranslations, type Lang } from "../../constants/i18n"
import { BOOKING_URL } from "../../constants/links"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
---

<section class="bg-white py-12 md:py-16">
	<div class="mx-auto max-w-6xl px-4">
		<h2 class="text-center text-2xl font-bold text-stone-900 md:text-3xl">
			{t.reviews.title}
		</h2>
		<div class="mt-10 grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 md:gap-8">
			{
				t.reviews.items.map((review) => (
					<figure class="flex h-full flex-col rounded-2xl border border-stone-200 bg-stone-50 p-6">
						<p class="text-sm font-semibold text-brand">{review.score}/10</p>
						<blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-stone-600">
							“{review.quote}”
						</blockquote>
						<figcaption class="mt-5 text-sm font-semibold text-stone-900">
							{review.author}
						</figcaption>
					</figure>
				))
			}
		</div>
		<div class="mt-8 text-center">
			<a
				href={BOOKING_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="text-base font-medium text-brand hover:underline"
			>
				{t.reviews.cta}
			</a>
		</div>
	</div>
</section>
