---
import { getTranslations, type Lang } from "../../constants/i18n"
import {
	GALLERY_ITEMS,
	GALLERY_CATEGORY_ORDER,
} from "../../constants/gallery"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const g = t.gallery

const items = GALLERY_ITEMS.map((item) => {
	const photo = g.photos[item.id as keyof typeof g.photos]
	return {
		id: item.id,
		src: item.src,
		category: item.category,
		width: item.width,
		height: item.height,
		caption: photo.caption,
		alt: photo.alt,
		categoryLabel: g.categories[item.category as keyof typeof g.categories],
	}
})

const pill =
	"rounded-full border-[1.5px] border-[#e2ded4] px-5 py-[9px] text-[0.88rem] font-medium transition hover:border-ink"
const pillOn = "!border-night bg-night text-white"

const galleryConfig = JSON.stringify({
	items,
	allLabel: g.all,
	close: g.close,
	prev: g.prev,
	next: g.next,
	openLabel: g.openLabel,
	categories: g.categories,
	categoryOrder: GALLERY_CATEGORY_ORDER,
})
---

<section id="galeria" class="pb-[74px] lg:pb-[100px]" data-gallery>
	<script is:inline type="application/json" data-gallery-config set:html={galleryConfig} />
	<div class="mx-auto max-w-[1180px] px-5 sm:px-7">
		<div class="reveal mb-[34px] flex flex-wrap items-end justify-between gap-6">
			<div>
				<span class="kicker">{t.homeUi.kickers.photos}</span>
				<h2 class="text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.08]">{g.title}</h2>
				<p class="mt-3 max-w-[560px] text-[1.12rem] leading-relaxed text-[#646a73]">{g.subtitle}</p>
			</div>
			<nav aria-label={g.filterLabel} class="flex flex-wrap gap-2" data-gallery-filters>
				<button type="button" data-filter="all" class={`${pill} ${pillOn}`} aria-pressed="true">{g.all}</button>
				{
					GALLERY_CATEGORY_ORDER.map((cat) => (
						<button type="button" data-filter={cat} class={pill} aria-pressed="false">
							{g.categories[cat]}
						</button>
					))
				}
			</nav>
		</div>
		<ul class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3" data-gallery-grid />
	</div>

	<div
		class="fixed inset-0 z-[1000] hidden items-center justify-center bg-[rgba(10,12,15,0.94)] p-4"
		data-gallery-lightbox
		role="dialog"
		aria-modal="true"
		hidden
	>
		<button
			type="button"
			data-gallery-close
			class="absolute right-4 top-4 z-10 rounded-full bg-white/10 px-3 py-1.5 text-sm text-white hover:bg-white/20"
		>
			{g.close}
		</button>
		<button
			type="button"
			data-gallery-prev
			class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 px-3 py-2 text-white hover:bg-white/20 md:left-6"
			aria-label={g.prev}
		>
			‹
		</button>
		<button
			type="button"
			data-gallery-next
			class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 px-3 py-2 text-white hover:bg-white/20 md:right-6"
			aria-label={g.next}
		>
			›
		</button>
		<figure class="relative flex max-h-[90vh] max-w-5xl flex-col items-center" data-gallery-figure>
			<img
				src=""
				alt=""
				class="max-h-[78vh] w-auto max-w-full rounded-[10px] object-contain"
				data-gallery-image
			/>
			<figcaption class="mt-4 max-w-xl text-center text-sm text-white/90 md:text-base">
				<span class="block text-xs uppercase tracking-wide text-white/55" data-gallery-meta />
				<span class="mt-1 block" data-gallery-caption />
			</figcaption>
		</figure>
	</div>
</section>

<script>
	function initGallery(root: Element) {
		const configEl = root.querySelector("[data-gallery-config]")
		if (!configEl?.textContent) return

		const config = JSON.parse(configEl.textContent)
		const grid = root.querySelector("[data-gallery-grid]") as HTMLUListElement | null
		const filters = root.querySelectorAll<HTMLElement>("[data-filter]")
		const lightbox = root.querySelector("[data-gallery-lightbox]") as HTMLElement | null
		const image = root.querySelector("[data-gallery-image]") as HTMLImageElement | null
		const meta = root.querySelector("[data-gallery-meta]")
		const caption = root.querySelector("[data-gallery-caption]")
		const closeBtn = root.querySelector("[data-gallery-close]") as HTMLButtonElement | null
		const prevBtn = root.querySelector("[data-gallery-prev]")
		const nextBtn = root.querySelector("[data-gallery-next]")
		const figure = root.querySelector("[data-gallery-figure]")

		if (!grid || !lightbox || !image || !meta || !caption) return

		let activeFilter = "all"
		let openIndex: number | null = null

		const visibleItems = () =>
			activeFilter === "all"
				? config.items
				: config.items.filter((item: { category: string }) => item.category === activeFilter)

		const render = () => {
			const items = visibleItems()
			grid.innerHTML = items
				.map(
					(
						item: {
							src: string
							alt: string
							caption: string
							categoryLabel: string
							width?: number
							height?: number
						},
						index: number,
					) => {
						const featured = index === 0
						const dims =
							item.width && item.height
								? `width="${item.width}" height="${item.height}"`
								: ""
						return `<li class="${featured ? "sm:col-span-2 lg:row-span-2" : ""}">
						<button type="button" data-open="${index}" class="group relative block h-full w-full cursor-zoom-in overflow-hidden rounded-2xl bg-sand text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ecb434] focus-visible:ring-offset-2" aria-label="${config.openLabel}: ${item.alt}">
							<img src="${item.src}" alt="${item.alt}" ${dims} class="aspect-[4/3] h-full w-full object-cover transition duration-700 group-hover:scale-105 ${featured ? "lg:aspect-auto" : ""}" loading="lazy" decoding="async" />
							<span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/80 to-transparent px-5 pb-4 pt-[34px] text-[0.88rem] font-medium text-white">${item.caption}</span>
						</button>
					</li>`
					},
				)
				.join("")

			grid.querySelectorAll("[data-open]").forEach((btn) => {
				btn.addEventListener("click", () => {
					openIndex = Number((btn as HTMLElement).dataset.open)
					showLightbox()
				})
			})
		}

		const showLightbox = () => {
			const items = visibleItems()
			if (openIndex === null || !items[openIndex]) return
			const item = items[openIndex]
			image.src = item.src
			image.alt = item.alt
			meta.textContent = `${item.categoryLabel} ${openIndex + 1}/${items.length}`
			caption.textContent = item.caption
			lightbox.hidden = false
			lightbox.classList.remove("hidden")
			lightbox.classList.add("flex")
			document.body.style.overflow = "hidden"
			closeBtn?.focus()
		}

		const hideLightbox = () => {
			openIndex = null
			lightbox.hidden = true
			lightbox.classList.add("hidden")
			lightbox.classList.remove("flex")
			document.body.style.overflow = ""
		}

		const showPrev = () => {
			const items = visibleItems()
			if (openIndex === null || !items.length) return
			openIndex = (openIndex - 1 + items.length) % items.length
			showLightbox()
		}

		const showNext = () => {
			const items = visibleItems()
			if (openIndex === null || !items.length) return
			openIndex = (openIndex + 1) % items.length
			showLightbox()
		}

		filters.forEach((btn) => {
			btn.addEventListener("click", () => {
				activeFilter = (btn as HTMLElement).dataset.filter || "all"
				filters.forEach((f) => {
					const active = f === btn
					f.setAttribute("aria-pressed", active ? "true" : "false")
					f.classList.toggle("!border-night", active)
					f.classList.toggle("bg-night", active)
					f.classList.toggle("text-white", active)
				})
				openIndex = null
				hideLightbox()
				render()
			})
		})

		closeBtn?.addEventListener("click", hideLightbox)
		prevBtn?.addEventListener("click", (e) => {
			e.stopPropagation()
			showPrev()
		})
		nextBtn?.addEventListener("click", (e) => {
			e.stopPropagation()
			showNext()
		})
		lightbox.addEventListener("click", hideLightbox)
		figure?.addEventListener("click", (e) => e.stopPropagation())
		window.addEventListener("keydown", (e) => {
			if (lightbox.hidden) return
			if (e.key === "Escape") hideLightbox()
			if (e.key === "ArrowLeft") showPrev()
			if (e.key === "ArrowRight") showNext()
		})

		render()
	}

	document.querySelectorAll("[data-gallery]").forEach(initGallery)
</script>
