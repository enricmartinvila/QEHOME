---
import { getTranslations, type Lang } from "../../constants/i18n"
import {
	GALLERY_ITEMS,
	GALLERY_CATEGORY_ORDER,
} from "../../constants/gallery"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const t = getTranslations(lang)
const g = t.gallery

const items = GALLERY_ITEMS.map((item) => {
	const photo = g.photos[item.id as keyof typeof g.photos]
	return {
		id: item.id,
		src: item.src,
		category: item.category,
		caption: photo.caption,
		alt: photo.alt,
		categoryLabel: g.categories[item.category as keyof typeof g.categories],
	}
})

const galleryConfig = JSON.stringify({
	items,
	allLabel: g.all,
	close: g.close,
	prev: g.prev,
	next: g.next,
	openLabel: g.openLabel,
	categories: g.categories,
	categoryOrder: GALLERY_CATEGORY_ORDER,
})
---

<section id="galeria" class="bg-stone-100 py-14 md:py-20" data-gallery>
	<script is:inline type="application/json" data-gallery-config set:html={galleryConfig} />
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">{g.title}</h2>
			<p class="mt-3 text-[15px] leading-relaxed text-stone-600 md:text-base">
				{g.subtitle}
			</p>
		</div>
		<nav
			aria-label={g.filterLabel}
			class="mt-8 flex flex-wrap justify-center gap-x-1 gap-y-2 text-sm md:mt-10"
			data-gallery-filters
		>
			<button
				type="button"
				data-filter="all"
				class="px-3 py-1.5 font-semibold text-stone-900"
				aria-pressed="true"
			>
				{g.all}
			</button>
			{
				GALLERY_CATEGORY_ORDER.map((cat) => (
					<span class="inline-flex items-center">
						<span aria-hidden="true" class="mx-1 text-stone-300">
							·
						</span>
						<button
							type="button"
							data-filter={cat}
							class="px-3 py-1.5 text-stone-500 transition-colors hover:text-stone-800"
							aria-pressed="false"
						>
							{g.categories[cat]}
						</button>
					</span>
				))
			}
		</nav>
		<ul class="mt-8 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-3 md:gap-4" data-gallery-grid />
	</div>

	<div
		class="fixed inset-0 z-[1000] hidden items-center justify-center bg-black/90 p-4"
		data-gallery-lightbox
		role="dialog"
		aria-modal="true"
		hidden
	>
		<button
			type="button"
			data-gallery-close
			class="absolute right-4 top-4 z-10 rounded-full bg-white/10 px-3 py-1.5 text-sm text-white hover:bg-white/20"
		>
			{g.close}
		</button>
		<button
			type="button"
			data-gallery-prev
			class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 px-3 py-2 text-white hover:bg-white/20 md:left-6"
			aria-label={g.prev}
		>
			‹
		</button>
		<button
			type="button"
			data-gallery-next
			class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 px-3 py-2 text-white hover:bg-white/20 md:right-6"
			aria-label={g.next}
		>
			›
		</button>
		<figure class="relative flex max-h-[90vh] max-w-5xl flex-col items-center" data-gallery-figure>
			<img
				src=""
				alt=""
				class="max-h-[78vh] w-auto max-w-full object-contain"
				data-gallery-image
			/>
			<figcaption class="mt-4 max-w-xl text-center text-sm text-white/90 md:text-base">
				<span class="block text-xs uppercase tracking-wide text-white/55" data-gallery-meta />
				<span class="mt-1 block" data-gallery-caption />
			</figcaption>
		</figure>
	</div>
</section>

<script>
	function initGallery(root: Element) {
		const configEl = root.querySelector("[data-gallery-config]")
		if (!configEl?.textContent) return

		const config = JSON.parse(configEl.textContent)
		const grid = root.querySelector("[data-gallery-grid]") as HTMLUListElement | null
		const filters = root.querySelectorAll<HTMLElement>("[data-filter]")
		const lightbox = root.querySelector("[data-gallery-lightbox]") as HTMLElement | null
		const image = root.querySelector("[data-gallery-image]") as HTMLImageElement | null
		const meta = root.querySelector("[data-gallery-meta]")
		const caption = root.querySelector("[data-gallery-caption]")
		const closeBtn = root.querySelector("[data-gallery-close]") as HTMLButtonElement | null
		const prevBtn = root.querySelector("[data-gallery-prev]")
		const nextBtn = root.querySelector("[data-gallery-next]")
		const figure = root.querySelector("[data-gallery-figure]")

		if (!grid || !lightbox || !image || !meta || !caption) return

		let activeFilter = "all"
		let openIndex: number | null = null

		const visibleItems = () =>
			activeFilter === "all"
				? config.items
				: config.items.filter((item: { category: string }) => item.category === activeFilter)

		const render = () => {
			const items = visibleItems()
			grid.innerHTML = items
				.map(
					(item: { src: string; alt: string; caption: string; categoryLabel: string }, index: number) => {
						const featured = index === 0
						return `<li class="${featured ? "col-span-2 md:col-span-2 md:row-span-2" : ""}">
						<button type="button" data-open="${index}" class="group relative block w-full overflow-hidden bg-stone-200 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ca9b2c] focus-visible:ring-offset-2" aria-label="${config.openLabel}: ${item.alt}">
							<img src="${item.src}" alt="${item.alt}" class="w-full object-cover transition duration-500 group-hover:scale-[1.02] ${featured ? "aspect-[4/3] md:aspect-auto md:h-full md:min-h-[28rem]" : "aspect-[4/3]"}" loading="${index < 3 ? "eager" : "lazy"}" decoding="async" />
							<span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/65 to-transparent px-3 pb-3 pt-10">
								<span class="block text-xs font-medium uppercase tracking-wide text-white/80">${item.categoryLabel}</span>
								<span class="mt-0.5 block text-sm font-medium text-white md:text-base">${item.caption}</span>
							</span>
						</button>
					</li>`
					},
				)
				.join("")

			grid.querySelectorAll("[data-open]").forEach((btn) => {
				btn.addEventListener("click", () => {
					openIndex = Number((btn as HTMLElement).dataset.open)
					showLightbox()
				})
			})
		}

		const showLightbox = () => {
			const items = visibleItems()
			if (openIndex === null || !items[openIndex]) return
			const item = items[openIndex]
			image.src = item.src
			image.alt = item.alt
			meta.textContent = `${item.categoryLabel} ${openIndex + 1}/${items.length}`
			caption.textContent = item.caption
			lightbox.hidden = false
			lightbox.classList.remove("hidden")
			lightbox.classList.add("flex")
			document.body.style.overflow = "hidden"
			closeBtn?.focus()
		}

		const hideLightbox = () => {
			openIndex = null
			lightbox.hidden = true
			lightbox.classList.add("hidden")
			lightbox.classList.remove("flex")
			document.body.style.overflow = ""
		}

		const showPrev = () => {
			const items = visibleItems()
			if (openIndex === null || !items.length) return
			openIndex = (openIndex - 1 + items.length) % items.length
			showLightbox()
		}

		const showNext = () => {
			const items = visibleItems()
			if (openIndex === null || !items.length) return
			openIndex = (openIndex + 1) % items.length
			showLightbox()
		}

		filters.forEach((btn) => {
			btn.addEventListener("click", () => {
				activeFilter = (btn as HTMLElement).dataset.filter || "all"
				filters.forEach((f) => {
					const active = f === btn
					f.setAttribute("aria-pressed", active ? "true" : "false")
					f.classList.toggle("font-semibold", active)
					f.classList.toggle("text-stone-900", active)
					f.classList.toggle("text-stone-500", !active)
				})
				openIndex = null
				hideLightbox()
				render()
			})
		})

		closeBtn?.addEventListener("click", hideLightbox)
		prevBtn?.addEventListener("click", (e) => {
			e.stopPropagation()
			showPrev()
		})
		nextBtn?.addEventListener("click", (e) => {
			e.stopPropagation()
			showNext()
		})
		lightbox.addEventListener("click", hideLightbox)
		figure?.addEventListener("click", (e) => e.stopPropagation())
		window.addEventListener("keydown", (e) => {
			if (lightbox.hidden) return
			if (e.key === "Escape") hideLightbox()
			if (e.key === "ArrowLeft") showPrev()
			if (e.key === "ArrowRight") showNext()
		})

		render()
	}

	document.querySelectorAll("[data-gallery]").forEach(initGallery)
</script>
