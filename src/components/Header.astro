---
import LanguageSwitcher from "./LanguageSwitcher.astro"
import { localizedPath, type Lang } from "../constants/site"
import { getTranslations } from "../constants/i18n"
import { PHONE_DISPLAY, PHONE_TEL } from "../constants/links"

interface Props {
	lang: Lang
	pathAfterLang?: string
}

const { lang, pathAfterLang = "" } = Astro.props
const t = getTranslations(lang)
const homeHref = localizedPath(lang)
---

<header data-site-header class="fixed inset-x-0 top-0 z-[999] text-white transition-colors duration-300">
	<div class="mx-auto flex h-[68px] max-w-[1180px] items-center justify-between px-5 sm:h-[76px] sm:px-7">
		<a href={homeHref} aria-label="QEhome Manresa" data-logo-home class="flex-shrink-0">
			<img src="/logo/logosintexto.webp" alt="QEhome Manresa" class="h-8 w-auto sm:h-[38px]" width="120" height="38" />
		</a>
		<div class="flex items-center gap-4 text-[0.9rem] sm:gap-6">
			<LanguageSwitcher lang={lang} pathAfterLang={pathAfterLang} />
			<a href={`tel:${PHONE_TEL}`} class="flex items-center gap-2 font-medium transition hover:text-brand-cta" aria-label={PHONE_DISPLAY}>
				<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
				</svg>
				<span class="hidden lg:inline">{PHONE_DISPLAY}</span>
			</a>
			<a href="#contacto" class="btn btn-amber hidden !px-6 !py-[11px] !text-[0.9rem] sm:inline-flex">{t.titles.book_now}</a>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector("[data-site-header]")
	if (header) {
		const isHome = /^\/(ca|es|en)\/?$/.test(window.location.pathname)
		const update = () => {
			const solid = window.scrollY > 60 || !isHome
			header.classList.toggle("bg-night/90", solid)
			header.classList.toggle("backdrop-blur-md", solid)
		}
		header.querySelector("[data-logo-home]")?.addEventListener("click", (e) => {
			if (isHome) {
				e.preventDefault()
				window.scrollTo({ top: 0, behavior: "smooth" })
			}
		})
		window.addEventListener("scroll", update, { passive: true })
		update()
	}
</script>
