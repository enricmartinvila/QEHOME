---
import {
	SITE_URL,
	LANGS,
	DEFAULT_LANG,
	OG_LOCALE,
	type Lang,
} from "../constants/site"

interface Props {
	lang: Lang
	title: string
	description: string
	pathAfterLang?: string
	ogImage?: string
	ogType?: "website" | "article"
	preloadImage?: string
	robots?: string
}

const {
	lang,
	title,
	description,
	pathAfterLang = "",
	ogImage: ogImageProp,
	ogType = "website",
	preloadImage,
	robots = "index,follow",
} = Astro.props

const suffix = pathAfterLang.replace(/^\//, "")
const canonicalPath = suffix ? `/${lang}/${suffix}/` : `/${lang}/`
const canonical = `${SITE_URL}${canonicalPath}`
const ogImagePath = ogImageProp || "/images/hab3.webp"
const ogImage = ogImagePath.startsWith("http")
	? ogImagePath
	: `${SITE_URL}${ogImagePath}`

function hreflangPath(l: Lang) {
	if (!suffix) return `${SITE_URL}/${l}/`
	return `${SITE_URL}/${l}/${suffix}/`
}

const alternateLocales = LANGS.filter((l) => l !== lang)
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{
	LANGS.map((l) => (
		<link rel="alternate" hreflang={l} href={hreflangPath(l)} />
	))
}
<link rel="alternate" hreflang="x-default" href={hreflangPath(DEFAULT_LANG)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="QEhome Manresa" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{
	alternateLocales.map((l) => (
		<meta property="og:locale:alternate" content={OG_LOCALE[l]} />
	))
}
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{
	preloadImage && (
		<link
			rel="preload"
			as="image"
			href={preloadImage}
			fetchpriority="high"
		/>
	)
}
<link rel="icon" type="image/webp" href="/logo/logoshort.webp" />
