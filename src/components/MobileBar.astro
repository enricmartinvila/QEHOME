---
import { getTranslations, type Lang } from "../constants/i18n"
import { WHATSAPP_URL } from "../constants/links"

interface Props {
	lang: Lang
}

const { lang } = Astro.props
const ui = getTranslations(lang).homeUi
---

<nav class="fixed inset-x-0 bottom-0 z-[70] flex gap-2.5 bg-night px-3.5 py-2.5 shadow-[0_-10px_30px_rgba(0,0,0,0.3)] sm:hidden" aria-label={ui.mobileAvailability}>
	<a href="#contacto" class="flex-1 rounded-full bg-brand-cta p-3 text-center text-[0.92rem] font-semibold text-night">{ui.mobileAvailability}</a>
	<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-full border-[1.5px] border-white/35 p-3 text-center text-[0.92rem] font-semibold text-white">WhatsApp</a>
</nav>
